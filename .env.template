# Discord
DISCORD_ACCESS_TOKEN=your_discord_bot_token_here

# Hellfall postcard ingest (must match hellfall MORK_POSTCARD_API_KEY)
# HELLFALL_API_URL=
# HELLFALL_POSTCARD_API_KEY=
# MORK_POSTCARD_SYNC=1  # cards only; token images always go through hellfall

# Reddit API credentials
REDDIT_ID=your_reddit_app_id
REDDIT_SECRET=your_reddit_app_secret
REDDIT_PASSWORD=your_reddit_password
REDDIT_NAME=your_reddit_app_name
REDDIT_USER_AGENT=your_user_agent_string

# Stage-1 Devvit migration — acceptance posts (asyncpraw default; leave unset for deploy)
# REDDIT_ACCEPT_VIA_DEVVIT=1
# External URL: https://{app-slug}-{subreddit-id}-external.devvit.net/external/post-card
# Use the t5 ID *without* the t5_ prefix (e.g. t5_21otlg → 21otlg).
# Requires Reddit to enable external endpoints for your account (see mork-devvit/README.md).
# DEVVIT_POST_CARD_URL=...
# Managed App Token from Devvit developer settings (devvit_at_…), not postCardSecret.
# DEVVIT_POST_CARD_SECRET=devvit_at_…

# Card of the day via Devvit scheduler (on for current deploy)
REDDIT_COTD_VIA_DEVVIT=1
# hellscube-bridge global setting cardOfTheDayViaDevvit defaults true in devvit.json

# Reddit → Discord mirror via Devvit PostSubmit (off; Mork check_reddit remains default)
# REDDIT_MIRROR_VIA_DEVVIT=1

# Daily gallery manifest (on) + posting still on Mork asyncpraw until Devvit gallery API exists
REDDIT_GALLERY_USE_MANIFEST=1
# REDDIT_GALLERY_VIA_DEVVIT=1

# Discord #reddit → Reddit comment via Devvit (off until external endpoints approved)
# REDDIT_REPLY_VIA_DEVVIT=1
